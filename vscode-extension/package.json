{
  "name": "ai-dev-bridge-vscode",
  "displayName": "AI Dev Bridge",
  "description": "View locally captured ChatGPT responses in VS Code.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "ISC",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCommand:aiDevBridge.showCaptures"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiDevBridge.showCaptures",
        "title": "AI Dev Bridge: Show Captures"
      }
    ],
    "configuration": {
      "title": "AI Dev Bridge",
      "properties": {
        "aiDevBridge.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3000",
          "description": "Local AI Dev Bridge server URL."
        },
        "aiDevBridge.tokenFile": {
          "type": "string",
          "default": "",
          "description": "Optional token path override. Relative paths resolve from the AI Dev Bridge project root."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.js",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}
