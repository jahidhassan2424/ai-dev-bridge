{
  "manifest_version": 3,
  "name": "AI Development Bridge",
  "version": "1.0.0",
  "description": "Sends test messages to the local AI Development Bridge server.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Development Bridge"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["conversation.js", "capture-logic.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
